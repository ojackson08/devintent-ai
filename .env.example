# ===================== GitHub =====================
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: public_repo (read-only is sufficient)
GITHUB_TOKEN=your_github_pat_here

# ===================== OpenRouter (LLM Classification) =====================
# Get your key at https://openrouter.ai/keys
OPENROUTER_OWL_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=owl-alpha

# ===================== DevIntent Pipeline Settings =====================
# Comma-separated list of GitHub repos to monitor for signals
TARGET_REPOS=Significant-Gravitas/AutoGPT,open-webui/open-webui,ollama/ollama,n8n-io/n8n,langgenius/dify

# Minimum ICP fit score (0-100) to save a lead — default 60
MIN_LEAD_SCORE=60

# Paths (update to your local environment)
DB_PATH=./data/devintent.db
OUTPUT_DIR=./data

# Performance tuning
BATCH_SIZE=50
MAX_WORKERS=8
USER_CACHE_TTL=21600
